#!/bin/sh
# Runs CI's ruff lint and format check on the staged Python files under pipeline/ and
# clients/python/, each from its own directory so its own settings apply, reading the staged
# content so an unstaged fix cannot hide a fault. Skip once with git commit --no-verify.

# Workflow lint: actionlint with shellcheck, and zizmor at CI's persona, over a copy of the staged
# files the Workflow lint job reads. zizmor runs offline, so the hook needs no network or token. A
# failure here still lets the Python check below run, and the EXIT trap then fails the commit.
wf_paths=".github/workflows .github/actions .github/actionlint.yaml"
# shellcheck disable=SC2086 # wf_paths is a list of paths without spaces
if [ -n "$(git diff --cached --name-only -- $wf_paths)" ]; then
  wf_ci=$(git show :.github/workflows/ci.yml 2>/dev/null)
  wf_failed=0
  for wf_tool in actionlint shellcheck zizmor; do
    case $wf_tool in
      actionlint) wf_var=ACTIONLINT_VERSION wf_how=https://github.com/rhysd/actionlint/releases/tag/v ;;
      shellcheck) wf_var=SHELLCHECK_VERSION wf_how=https://github.com/koalaman/shellcheck/releases/tag/v ;;
      zizmor) wf_var=ZIZMOR_VERSION wf_how="uv tool install zizmor==" ;;
    esac
    wf_pin=$(printf '%s\n' "$wf_ci" | sed -n "s/^ *$wf_var: *//p" | head -n 1)
    if ! command -v "$wf_tool" >/dev/null 2>&1; then
      echo "pre-commit: $wf_tool not found; install $wf_tool $wf_pin, the version ci.yml pins: $wf_how$wf_pin"
      wf_failed=1
      continue
    fi
    wf_have=$("$wf_tool" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n 1)
    [ "$wf_have" = "$wf_pin" ] ||
      echo "pre-commit: warning: $wf_tool is ${wf_have:-of unknown version} here and $wf_pin in CI"
  done
  # actionlint finds its project, and so actionlint.yaml, by a .git beside .github. An unparsable
  # workflow fails zizmor under --strict-collection instead of dropping out of the audit.
  if [ "$wf_failed" -eq 0 ]; then
    if wf_tree=$(mktemp -d); then
      trap 'rm -rf "$wf_tree"; exit 1' INT TERM HUP
      # shellcheck disable=SC2086
      if mkdir "$wf_tree/.git" &&
        git ls-files -z -- $wf_paths | git checkout-index -z --stdin --prefix="$wf_tree/"; then
        (cd "$wf_tree" && actionlint -shellcheck "$(command -v shellcheck)") || wf_failed=1
        (cd "$wf_tree" && zizmor --offline --persona auditor --strict-collection --format plain \
          --no-progress .github) || wf_failed=1
      else
        wf_failed=1
      fi
      rm -rf "$wf_tree"
      trap - INT TERM HUP
    else
      wf_failed=1
    fi
  fi
  if [ "$wf_failed" -ne 0 ]; then
    echo "pre-commit: workflow lint found problems; fix them or commit with --no-verify"
    trap 'exit 1' EXIT
  fi
fi

# ESLint and Prettier, as pinned in package-lock.json, on the staged JavaScript in the directories
# their allow-lists open and on the two tools' own config; the configs decide within them. A
# missing node_modules fails the commit because CI always runs both. A failure lets the checks
# below run, and the EXIT trap then fails the commit.
js=$(git diff --cached --name-only --diff-filter=ACMR -- 'functions/*.js' 'functions/*.mjs' \
  'scripts/*.js' 'scripts/*.mjs' 'explorer/*.js' 'explorer/*.mjs' \
  'pipeline/publicdata/static/*.js' 'pipeline/publicdata/static/*.mjs' eslint.config.mjs \
  .prettierrc.json)
if [ -n "$js" ]; then
  if [ ! -x node_modules/.bin/eslint ] || [ ! -x node_modules/.bin/prettier ] || ! command -v npx >/dev/null 2>&1; then
    echo "pre-commit: JavaScript is staged but node or node_modules is missing (run: npm ci --ignore-scripts)"
    trap 'exit 1' EXIT
  else
    jsfailed=0
    IFS='
'
    for f in $js; do
      git show ":$f" | npx --no-install eslint --max-warnings 0 --no-warn-ignored --stdin --stdin-filename "$f" || jsfailed=1
      if ! git show ":$f" | npx --no-install prettier --check --stdin-filepath "$f" >/dev/null 2>&1; then
        echo "$f: not formatted as Prettier would (run: npx prettier --write $f)"
        jsfailed=1
      fi
    done
    unset IFS
    if [ "$jsfailed" -ne 0 ]; then
      echo "pre-commit: ESLint or Prettier found problems; fix them or commit with --no-verify"
      trap 'exit 1' EXIT
    fi
  fi
fi

# lintr and styler, at the versions clients.yml pins, over a copy of the staged R client, run as
# the R client job runs them. A missing R or package fails the commit because CI always runs both.
# A failure lets the Python check below run, and the EXIT trap then fails the commit.
r_files=$(git diff --cached --name-only -- 'clients/r/*.R' 'clients/r/*.Rmd' clients/r/.lintr \
  clients/r/DESCRIPTION)
if [ -n "$r_files" ]; then
  r_pins=$(git show :.github/workflows/clients.yml 2>/dev/null |
    grep -oE '(lintr|cyclocomp|styler)@[0-9.]+')
  r_failed=0
  if ! command -v Rscript >/dev/null 2>&1; then
    r_list=$(printf '%s\n' "$r_pins" | sed 's/.*/"&"/' | paste -sd, - | sed 's/,/, /g')
    echo "pre-commit: Rscript not found; install R from https://cloud.r-project.org, then the packages at the versions clients.yml pins: Rscript -e 'pak::pak(c($r_list))'"
    r_failed=1
  else
    r_have=$(Rscript -e 'for (p in c("lintr", "cyclocomp", "styler")) cat(p, tryCatch(format(packageVersion(p)), error = function(e) "missing"), "\n")' 2>/dev/null)
    for r_pkg in lintr cyclocomp styler; do
      r_pin=$(printf '%s\n' "$r_pins" | grep -oE "$r_pkg@[0-9.]+" | head -n 1)
      r_ver=$(printf '%s\n' "$r_have" | sed -n "s/^$r_pkg \([^ ]*\).*/\1/p")
      if [ -z "$r_pin" ]; then
        echo "pre-commit: clients.yml pins no version of $r_pkg; add it where the R client job installs its packages"
        r_failed=1
      elif [ -z "$r_ver" ] || [ "$r_ver" = missing ]; then
        echo "pre-commit: R package $r_pkg not found; install $r_pin, the version clients.yml pins: Rscript -e 'pak::pak(\"$r_pin\")'"
        r_failed=1
      elif [ "$r_pkg@$r_ver" != "$r_pin" ]; then
        echo "pre-commit: warning: $r_pkg is $r_ver here and ${r_pin#*@} in CI"
      fi
    done
  fi
  if [ "$r_failed" -eq 0 ]; then
    if r_tree=$(mktemp -d); then
      trap 'rm -rf "$r_tree"; exit 1' INT TERM HUP
      if git ls-files -z -- clients/r | git checkout-index -z --stdin --prefix="$r_tree/"; then
        (cd "$r_tree/clients/r" &&
          Rscript -e 'lints <- lintr::lint_package(); print(lints); if (length(lints)) quit(status = 1L)') ||
          r_failed=1
        (cd "$r_tree/clients/r" && Rscript -e 'styler::style_pkg(dry = "fail")') || r_failed=1
      else
        r_failed=1
      fi
      rm -rf "$r_tree"
      trap - INT TERM HUP
    else
      r_failed=1
    fi
  fi
  if [ "$r_failed" -ne 0 ]; then
    echo "pre-commit: lintr or styler found problems in clients/r; fix them or commit with --no-verify"
    trap 'exit 1' EXIT
  fi
fi

files=$(git diff --cached --name-only --diff-filter=ACMR -- 'pipeline/*.py' 'clients/python/*.py')
[ -n "$files" ] || exit 0

if ! command -v ruff >/dev/null 2>&1; then
  echo "pre-commit: ruff not found; install it with uv pip install -e './pipeline[dev]' (or commit with --no-verify)"
  exit 1
fi

top=$(pwd)
failed=0
IFS='
'
for f in $files; do
  case $f in
    clients/python/*) dir=clients/python ;;
    *) dir=pipeline ;;
  esac
  rel=${f#"$dir"/}
  cd "$top/$dir" || exit 1
  git show ":$f" | ruff check --quiet --stdin-filename "$rel" - || failed=1
  if ! git show ":$f" | ruff format --check --quiet --stdin-filename "$rel" - >/dev/null 2>&1; then
    echo "$f: not formatted as ruff format would (run: cd $dir && ruff format $rel)"
    failed=1
  fi
done

[ "$failed" -eq 0 ] || echo "pre-commit: ruff found problems; fix them or commit with --no-verify"
exit "$failed"
